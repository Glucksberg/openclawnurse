[Unit]
Description=OpenClawNurse daily doctor run
After=default.target

[Service]
Type=oneshot
EnvironmentFile=__CONFIG_FILE__
EnvironmentFile=-%h/.openclaw/gateway.systemd.env
Environment=PATH=%h/.npm-global/bin:%h/.local/bin:%h/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=__INSTALL_DIR__
ExecStart=__INSTALL_DIR__/bin/openclaw-doctor.sh --config __CONFIG_FILE__
# Source-checkout updates build a staged candidate before activation.
MemoryHigh=__MEMORY_HIGH__
MemoryMax=__MEMORY_MAX__
MemorySwapMax=__MEMORY_SWAP_MAX__
CPUQuota=__CPU_QUOTA__
TasksMax=__TASKS_MAX__
